# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/docroot/core/
/docroot/modules/contrib/
/docroot/themes/contrib/
/docroot/profiles/contrib/
/docroot/libraries/
console/

# Ignore Drupal's file directory
/docroot/sites/*/files/

# Ignore SimpleTest multi-site environment.
/docroot/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/
.DS_Store
config/.DS_Store

# Ignore .env files as they are personal
/.env

#####
## BLT defaults below
#####
local.settings.php
local.drush.yml
local.site.yml
local.services.yml
*.local
local.blt.yml
deployment_identifier
/travis_wait*
/files-private
.phpcs-cache


# Scaffolded files (added by drupal/core scaffold)
/.editorconfig
/.gitattributes
/.drush-lock-update
/deploy
/pantheon.yml
/cron-log.txt
/time.log
